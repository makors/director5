{
	"linter": {
		"rules": {
			"recommended": true,
			"complexity": {
				"noStaticOnlyClass": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"enabled": true,
			"lineWidth": 100
		}
	},
	"files": {
		"ignore": ["build.css", "**/general/dist/**", "**/sites/vendor/**"],
		"ignoreUnknown": true
	}
}
